  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Mike Desjardins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdesjardins/prequel.git"
  },
  "homepage": "https://github.com/mdesjardins/prequel#readme",
