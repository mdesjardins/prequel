<!doctype html>
<html
  lang="en"
  data-color-mode="<%= colorMode %>"
  data-light-theme="light"
  data-dark-theme="dark"
  data-diff="<%= diffMode %>"
  data-branch="<%= branch %>"
  data-comments-enabled="<%= commentable ? '1' : '0' %>"
>
<%- include('partials/head', { title: `${path} — ${head}` }) %>
<body data-back-href="<%= backHref %>" data-deleted="<%= isDeleted ? '1' : '0' %>" data-plain="<%= plain ? '1' : '0' %>">
  <header class="pr-subnav">
    <div class="pr-subnav-inner">
      <div class="pr-title-row">
        <%- include('partials/tree-toggle') %>
        <a class="back-link" href="<%= backHref %>">← Back to review</a>
        <nav class="crumbs" aria-label="Breadcrumb">
          <span class="crumb crumb-repo"><%= repoPath.split('/').pop() %></span>
          <% crumbs.forEach((c, i) => { %>
          <span class="crumb-sep">/</span>
          <span class="crumb<%= i === crumbs.length - 1 ? ' crumb-file' : '' %>"><%= c %></span>
          <% }) %>
        </nav>
        <span class="pr-refs">
          <span class="ref-pill"><%= head %></span>
          <span class="ref-arrow">into</span>
          <span class="ref-pill"><%= base %></span>
        </span>
      </div>
      <div class="pr-meta-row">
        <span class="diff-summary">
          <% if (isBinary) { %>
            Binary file
          <% } else { %>
            <strong><%= lineCount %></strong> <%= lineCount === 1 ? 'line' : 'lines' %>
          <% } %>
          <% if (isDeleted) { %>
            <span class="file-notice file-notice-deleted">Deleted in this diff, showing base version</span>
          <% } %>
          <% if (plain) { %>
            <span class="file-notice">Syntax highlighting off for files over <%= maxHighlight.toLocaleString('en-US') %> lines</span>
          <% } %>
          <% if (!commentable && !isDeleted && !isBinary) { %>
            <span class="file-notice">Not in this diff, read-only</span>
          <% } %>
        </span>
        <span class="pr-meta-right">
          <span class="repo-path" title="<%= repoPath %>"><%= repoPath %></span>
        </span>
      </div>
    </div>
  </header>

  <div class="review-layout">
    <%- include('partials/tree-pane', { label: 'Repository files', header: 'Repository', treeHtml }) %>
    <main class="diff-container">
      <%- tableHtml %>
    </main>
  </div>

  <div id="toast" class="toast" hidden></div>

  <script src="/static/js/tree-pane.js"></script>
  <script src="/static/js/composer.js"></script>
  <script src="/static/js/comments.js"></script>
</body>
</html>
